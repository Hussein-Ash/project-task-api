<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <!--
      Pinned deliberately. Microsoft.AspNetCore.OpenApi 10.0.10 resolves Microsoft.OpenApi
      2.0.0 transitively, which carries GHSA-v5pm-xwqc-g5wc (high). 2.7.5 is the first
      patched release. Remove this line once the ASP.NET Core package ships the fix itself.
    -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.16.16" />
    <!--
      The EF Core tools resolve the DbContext through the startup project, so the design-time
      package has to be referenced here as well as in Infrastructure. PrivateAssets keeps it
      out of the published output.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- The API is the composition root, so it references the concrete Infrastructure types to register them. -->
  <ItemGroup>
    <ProjectReference Include="..\ProjectTaskApi.Application\ProjectTaskApi.Application.csproj" />
    <ProjectReference Include="..\ProjectTaskApi.Infrastructure\ProjectTaskApi.Infrastructure.csproj" />
  </ItemGroup>

</Project>
